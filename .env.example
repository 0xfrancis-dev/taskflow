APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (default). For zero-setup local testing use DB_CONNECTION=sqlite and create database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail: "log" writes emails to storage/logs. Switch to smtp for real delivery.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=francis.audits@gmail.com
MAIL_FROM_NAME=TaskFlow

# TaskFlow settings
SUPPORT_EMAIL=francis.audits@gmail.com
PLATFORM_FEE_PERCENT=10
MIN_REWARD=20
MIN_DEPOSIT=500
MIN_WITHDRAWAL=1000
REFERRAL_BONUS=100
PAY_BANK_NAME="Your Bank"
PAY_ACCOUNT_NUMBER=0000000000
PAY_ACCOUNT_NAME="TaskFlow Ltd"

# First admin account created by the seeder (change these!)
ADMIN_EMAIL=admin@taskflow.test
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
