APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (default). For zero-setup local testing use DB_CONNECTION=sqlite and create database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail: "log" writes emails to storage/logs. Switch to smtp for real delivery.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=francis.audits@gmail.com
MAIL_PASSWORD="rzrs ttli uzqn uxva"
MAIL_FROM_ADDRESS=francis.audits@gmail.com
MAIL_FROM_NAME=TaskFlow

# TaskFlow settings
SUPPORT_EMAIL=francis.audits@gmail.com
PLATFORM_FEE_PERCENT=10
MIN_REWARD=20
MIN_DEPOSIT=500
MIN_WITHDRAWAL=50
REFERRAL_BONUS=100
PAY_BANK_NAME="Your Bank"
PAY_ACCOUNT_NUMBER=0000000000
PAY_ACCOUNT_NAME="TaskFlow Ltd"

# Korapay (automatic wallet funding). Leave the key empty to use manual bank-transfer funding instead.
# Test keys start with sk_test_, live keys with sk_live_ (Korapay dashboard > Settings > API Configuration).
KORAPAY_SECRET_KEY=

# First admin account created by the seeder (change these!)
ADMIN_EMAIL=admin@taskflow.test
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true

# Monnify (online wallet funding). Sandbox: https://sandbox.monnify.com  Live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT=

# Show the manual bank-transfer funding form? (false = online Monnify payment only)
MANUAL_FUNDING=false

# Max total a single user can withdraw per day (NGN)
WITHDRAWAL_DAILY_LIMIT=200000
